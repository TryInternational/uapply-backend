<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Ulearn sub-agent agreement</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f2fa;font-family:Helvetica,Arial,sans-serif;color:#1a1628;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f2fa;padding:32px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #e6e2f0;">
            <tr>
              <td style="background:#6b4ee6;padding:22px 28px;">
                <img src="{{logoUrl}}" alt="Ulearn" width="122" height="36" style="display:block;width:122px;height:36px;border:0;outline:none;color:#ffffff;font-size:17px;font-weight:bold;letter-spacing:-0.2px;" />
              </td>
            </tr>
            <tr>
              <td style="padding:30px 28px 8px;">
                <h1 style="margin:0 0 12px;font-size:21px;line-height:1.3;color:#1a1628;">{{#if resend}}Your agreement is ready to sign (new link){{else}}Your agreement is ready to sign{{/if}}</h1>
                <p style="margin:0 0 14px;font-size:15px;line-height:1.6;color:#3f3a52;">
                  Hello {{name}} &mdash; good news: your request to work with Ulearn as a sub-agent has been approved.
                  Your agreement <strong>{{agreementNo}}</strong> is attached, and you can review and sign it online in a couple of minutes.
                </p>
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:22px 0;">
                  <tr>
                    <td style="background:#6b4ee6;border-radius:10px;">
                      <a href="{{signUrl}}" style="display:inline-block;padding:13px 26px;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none;">Review &amp; sign the agreement</a>
                    </td>
                  </tr>
                </table>
                <p style="margin:0 0 14px;font-size:14px;line-height:1.6;color:#75708a;">
                  The link is personal to you and works until <strong>{{expiresAt}}</strong>. Once you sign, Ulearn countersigns and you receive the completed copy by email, followed by your invitation to the sub-agent portal.
                </p>
                <p style="margin:0 0 6px;font-size:13px;line-height:1.6;color:#8e88a3;">If the button doesn&rsquo;t work, paste this into your browser:</p>
                <p style="margin:0;font-size:12.5px;line-height:1.5;word-break:break-all;color:#6b4ee6;">{{signUrl}}</p>
              </td>
            </tr>
            <tr>
              <td style="padding:22px 28px 28px;">
                <div style="border-top:1px solid #ece9f4;padding-top:16px;font-size:12.5px;color:#8e88a3;">
                  Questions about the terms? Reply to this email before signing. <br />
                  Ulearn Abroad &middot; Kuwait City &middot; This message was sent to {{email}}
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
