<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reminder: your Ulearn agreement is waiting</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f2fa;font-family:Helvetica,Arial,sans-serif;color:#1a1628;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f2fa;padding:32px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #e6e2f0;">
            <tr>
              <td style="background:#6b4ee6;padding:22px 28px;">
                <span style="color:#ffffff;font-size:17px;font-weight:bold;letter-spacing:-0.2px;">Ulearn</span>
              </td>
            </tr>
            <tr>
              <td style="padding:30px 28px 8px;">
                <h1 style="margin:0 0 12px;font-size:21px;line-height:1.3;color:#1a1628;">Your agreement is still waiting for your signature</h1>
                <p style="margin:0 0 14px;font-size:15px;line-height:1.6;color:#3f3a52;">
                  Hello {{name}} &mdash; a quick reminder that Sub-Agent Agreement <strong>{{agreementNo}}</strong> ({{commissionEn}}) is ready for you to review and sign. It takes a couple of minutes, and your portal opens as soon as it is done.
                </p>
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:22px 0;">
                  <tr>
                    <td style="background:#6b4ee6;border-radius:10px;">
                      <a href="{{signUrl}}" style="display:inline-block;padding:13px 26px;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none;">Review &amp; sign</a>
                    </td>
                  </tr>
                </table>
                <p style="margin:0 0 14px;font-size:14px;line-height:1.6;color:#75708a;">
                  The link works until <strong>{{expiresAt}}</strong>. If anything in the terms isn&rsquo;t right, just reply to this email.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:22px 28px 28px;">
                <div style="border-top:1px solid #ece9f4;padding-top:16px;font-size:12.5px;color:#8e88a3;">
                  Ulearn Abroad &middot; Kuwait City &middot; This message was sent to {{email}}
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
