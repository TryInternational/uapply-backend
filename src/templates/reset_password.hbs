<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link href='https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400;600;700&display=swap' rel='stylesheet' />
    <title>Ulearn | Test Later</title>
    <style>
      .container { width: 800px; margin: auto; } body, html, #wrapper { width: 100%; height: 100%; margin: 0; } #wrapper {
      display: table; } #main { display: table-cell; vertical-align: middle;} .icon-con { border: 1px solid #E8E9F5;
      box-sizing: border-box; border-radius: 8px; padding: 60px 0; width: 464px; border-bottom: none;
      border-bottom-left-radius: 0; border-bottom-right-radius: 0; position: relative; } .top-section { display: block;
      justify-content: center; align-items: center; } .level-text { font-style: normal; font-family: Cairo; font-weight:
      bold; font-size: 14px; color: #191C1F; } .result-con { background: rgba(232, 233, 245, 0.25); width: 464px;
      border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; } .top-section .text { font-family: Cairo; font-style:
      normal; text-align: left; font-weight: 600; font-size: 24px; color: #191c1f; } .top-section .subtext { font-family:
      Cairo; font-style: normal; font-weight: normal; font-size: 14px; color: #191C1F; } .mid-section { background: rgba(232,
      233, 245, 0.25); border: 1px solid #e8e9f5; box-sizing: border-box; border-radius: 4px; display: block; } .end-section
      { display: block; background: rgba(232, 233, 245, 0.25); border: 1px solid #e8e9f5; box-sizing: border-box;
      border-radius: 4px; margin-top: 16px; } .con { border-bottom: 1px solid #e8e9f5; } .box { background: rgba(232, 233,
      245, 0.25); border: 1px solid #E8E9F5; box-sizing: border-box; border-radius: 4px; margin: 40px 0 40px 0; padding:
      32px; border-top: 4.12px solid #299CF7; } .con .text { font-family: Cairo; font-style: normal; font-weight: normal;
      text-align: left; font-size: 14px; color: #191c1f; } .coupon-section { padding: 12px 0; width: 100%; border: 1px dashed
      #fd3e60; border-radius: 4px; } .border-container { background: #ffffff; border: 1px solid #35a7ff; box-sizing:
      border-box; border-radius: 8px; display: block; align-items: center; padding: 40px 0; } .complete-icon-container {
      position: relative; } .headertext { font-family: Cairo; font-style: normal; font-weight: 600; font-size: 21px; color:
      #191c1f; } .con .subtext { font-family: Cairo; font-style: normal; font-weight: normal; text-align: right; font-size:
      14px; color: #6b6c7f; } .button-blue { height: 52px; background: #35a7ff; border-radius: 8px; color: #fff; margin:
      30px; width: 159px; border: none; font-family: Cairo; font-style: normal; font-weight: 600; font-size: 16px; cursor:
      pointer; } .subtext { font-family: Cairo; font-style: normal; text-align: right; font-weight: normal; font-size: 10px;
      color: #6b6c7f; } .discounted-price { font-family: Cairo; font-style: normal; font-weight: normal; font-size: 18px;
      color: #333333; } .amount { font-style: normal; font-family: Cairo; font-weight: normal; font-size: 48px; line-height:
      48px; color: #191c1f; position: relative; top: 21px; left: 34px; } .gethelp { font-family: Cairo; font-style: normal;
      text-decoration: underline; font-weight: 600; font-size: 10px; text-transform: uppercase; color: #191c1f; } .colorText
      { font-family: Cairo; font-style: normal; font-weight: 600; font-size: 14px; text-align: right; line-height: 21px;
      color: #fd3e60; } .pricingtext { font-family: Cairo; font-style: normal; font-weight: 600; font-size: 14px; color:
      #191c1f; } .kd { font-family: Cairo; font-style: normal; font-weight: 600; font-size: 16px; color: #191c1f; }
      .price-section { padding: 16px 0; } .even-list { margin: 0; padding: 0; list-style-type: none; display: table;
      table-layout: fixed; width: 100%; } .el-item { display: table-cell; text-align: center; padding: 12px 24px;
      vertical-align: middle; } .footer { padding: 48px 0; border-top: 1px solid #e8e9f5; } @media (max-width: 992px) {
      .container { width: 100% !important; } .result-con { width: 100% !important; } .icon-con { min-width: 350px; width:
      100%; } }
    </style>
  </head>
  <body>
    <div id='wrapper'>
      <div id='main'>
        <div class='container'>
          <table style='width: 100%;'>
            <tr>
              <td>Dear user, To reset your password, click on this link:<br />
                {{resetPasswordUrl}}<br />
                If you did not request any password resets, then ignore this email.</td>
            </tr>
          </table>
        </div>
      </div>
    </div>
  </body>
</html>